{
  "name": "fittrack-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "start:api": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:api": "npm run build --workspace backend",
    "typecheck:api": "npm run typecheck --workspace backend",
    "typecheck:seed": "npm run typecheck:seed --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:deploy": "npm run db:deploy --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace frontend && npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
